VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA Enterprise site key para App Check. OBLIGATORIA en builds de
# producción: vite.config.js rompe el build si falta, porque sin ella el
# build queda verde pero la app muere contra un backend con App Check en
# enforce. En dev no se usa (el emulador bypassea App Check).
VITE_APPCHECK_SITE_KEY=

# Public v1 release: 'false' hides Estrategia / Financiamiento / CEO / Autopilot.
VITE_FEATURES_ADVANCED=false

# Support channels shown on every auth screen (login, sign-up, verify email,
# password reset). Set at least the email: a user whose verification email
# lands in spam has no other way to reach us. Empty → fallback link to
# comunplace.com. WhatsApp: digits with country code (50688887777).
# See docs/auth-email-delivery.md.
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_WHATSAPP=

# From-address of Firebase Auth emails, shown on the verify screen so users
# can search spam for it. Default (empty) = noreply@aurora-7dc9b.firebaseapp.com;
# update once the custom SMTP sender is configured.
VITE_AUTH_EMAIL_SENDER=
