rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Deny-all total: ningún acceso vía SDK cliente ni REST sin token.
    // Todos los assets del bucket (facturas en recepciones/, logos en config/,
    // escaneos en muestreos/) los sirve el backend, ya sea como signed URL v4
    // o como capability URL tokenizada (firebaseStorageDownloadTokens). Ambas
    // vías se validan ANTES de estas reglas, así que siguen funcionando a
    // pesar del deny-all — no agregar excepciones por prefijo: cualquier
    // match adicional reabre superficie que ningún código necesita.
    // Los tokens no expiran ni rotan salvo re-subida del objeto; aceptable
    // para datos no sensibles, NO reutilizar el patrón para assets sensibles
    // sin un esquema de expiración.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
