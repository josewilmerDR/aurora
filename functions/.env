# Cloud Functions runtime env vars (bundled at deploy, not a secrets store).
# For secrets use defineSecret() in lib/firebase.js. This file is committed.

# App Check enforcement mode: 'enforce' | 'warn' | 'off'.
# Rollout terminado: está en 'enforce' desde 2026-08-07. Volver a 'warn' solo
# como mitigación de emergencia si un cliente mal configurado tumba el tráfico
# legítimo — y con fecha de vuelta a 'enforce', no indefinidamente.
# Una mudanza de dominio exige registrarlo en reCAPTCHA Enterprise ANTES de
# desplegar, o todo el tráfico del dominio nuevo se rechaza con 401.
APP_CHECK_MODE=enforce

# Verificación del capability-token del deep link /task/:id:
# 'off' | 'warn' | 'enforce'. El default del código es 'warn' (ver
# lib/taskLinkToken.js), que servía cualquier scheduled_task a quien tuviera
# el doc id — el endpoint GET /api/tasks/:id no monta `authenticate`.
#
# En 'enforce' desde 2026-08-09. Precondiciones verificadas antes del flip:
#   - TASK_LINK_SECRET existe en Secret Manager, habilitado y de 49 chars
#     (readSecret() exige >=16; por debajo devuelve null y CADA link da 401).
#   - taskLinkSecret está en allSecrets (lib/firebase.js), o sea bindeado a la
#     función en runtime.
#   - El secreto data de 2026-04-24, muy por encima del TTL de 14 días de los
#     tokens, así que no queda ningún link vivo sin firma.
# Si alguna vez se rota o se borra el secreto, este modo debe volver a 'warn'
# en el mismo deploy: enforce sin secreto rompe todos los deep links de push.
TASK_LINK_TOKEN_MODE=enforce

# Public v1 release: 'false' (default) skips mounting routers and crons for
# Estrategia / Financiamiento / Meta-agencia / Orchestrator. Mirror of
# VITE_FEATURES_ADVANCED on the frontend.
FEATURES_ADVANCED=false

# Base URL de los deep-links en notificaciones push salientes. Validada y
# normalizada por resolveAppUrl() en lib/firebase.js (https, sin query);
# un valor inválido cae al default con warning.
# Una mudanza de dominio = editar esta línea + registrar el dominio en
# reCAPTCHA Enterprise + Authorized Domains + actualizar src/lib/ecosystem.js.
APP_URL=https://aurora.comunplace.com
